/*
Project: Marketplace Growth, Fulfilment and Customer Experience Intelligence
Purpose: Import the 11 source CSV files into the raw schema.

IMPORTANT:
1. Run this file through psql, not the pgAdmin Query Tool.
2. Do not run it against tables that already contain data.
3. Re-running it without clearing the tables will duplicate the data.
4. File paths are based on the original local project directory.
*/

\set ON_ERROR_STOP on


-- ============================================================
-- E-COMMERCE DATA
-- ============================================================

\copy raw.customers (
    customer_id,
    customer_unique_id,
    customer_zip_code_prefix,
    customer_city,
    customer_state
)
FROM 'C:/Users/Administrator/Desktop/marketplace-growth-intelligence/Data/raw/e-commerce/olist_customers_dataset.csv'
WITH (
    FORMAT CSV,
    HEADER TRUE,
    ENCODING 'UTF8',
    QUOTE '"'
);


\copy raw.orders (
    order_id,
    customer_id,
    order_status,
    order_purchase_timestamp,
    order_approved_at,
    order_delivered_carrier_date,
    order_delivered_customer_date,
    order_estimated_delivery_date
)
FROM 'C:/Users/Administrator/Desktop/marketplace-growth-intelligence/Data/raw/e-commerce/olist_orders_dataset.csv'
WITH (
    FORMAT CSV,
    HEADER TRUE,
    ENCODING 'UTF8',
    QUOTE '"'
);


\copy raw.order_items (
    order_id,
    order_item_id,
    product_id,
    seller_id,
